# Copy to .env and fill in real values. Never commit .env.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database password (Dashboard → Settings → Database) — used by npm run db:migrate:rcm
# SUPABASE_DB_PASSWORD=
# Or full connection string:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Demo / mock screens (leaderboard, security dashboard, etc.)
# true = show with "Demo data" banner; false = hide from nav + block URLs
# unset = enabled in development, disabled in production
NEXT_PUBLIC_DEMO_MODE=true

# Optional TURN for WebRTC across strict NATs (comma-separated URLs)
# NEXT_PUBLIC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Optional external WebSocket signaling (unused when using Supabase Realtime peer join)
# NEXT_PUBLIC_SIGNALING_SERVER_URL=wss://signaling.example.com

# AI providers (server-only)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# TTS — prefer server-only key (do not use NEXT_PUBLIC_ for secrets)
ELEVENLABS_API_KEY=
# NEXT_PUBLIC_ELEVENLABS_API_KEY=  # legacy fallback only

# Payments — Razorpay (primary). Stripe is disabled in this build.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: required for reliable webhook DB writes (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (disabled — endpoints return 503)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Calendly (server-only — do not use NEXT_PUBLIC_ for the token)
# CALENDLY_ACCESS_TOKEN=
# CALENDLY_USER_URI=https://api.calendly.com/users/YOUR-USER-UUID
# CALENDLY_DEFAULT_SCHEDULING_URL=https://calendly.com/your-handle
# CALENDLY_WEBHOOK_SECRET=long-random-string

# Cron / scheduled jobs (Bearer or x-cron-secret header)
# CRON_SECRET=long-random-string

# Optional
REDIS_URL=
FIELD_ENCRYPTION_KEY=
RESEND_API_KEY=
BREVO_API_KEY=
AIRTABLE_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
# NEXT_PUBLIC_CALENDLY_ACCESS_TOKEN=  # deprecated — use CALENDLY_ACCESS_TOKEN
